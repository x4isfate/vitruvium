{
  "name": "vitruvium-fvtt",
  "private": true,
  "type": "module",
  "description": "Система «ВИТРУВИЙ» для Foundry VTT и модуль кубиков для Dice So Nice",
  "scripts": {
    "rules": "python3 tools/extract-rules.py",
    "packs": "node tools/build-packs.mjs",
    "dice-art": "python3 tools/make-dice-art.py && node tools/render-dice-png.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "node tools/check-syntax.mjs",
    "dist": "node tools/build-packs.mjs && sh tools/dist.sh"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^1.0.3",
    "handlebars": "^4.7.8"
  }
}
