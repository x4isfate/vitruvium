<div class="v-top">
<header class="v-header">
  <div class="v-portrait" {{#if editable}}data-action="editPortrait"{{/if}} title="{{localize 'VITRUVIUM.Sheet.portrait'}}">
    <img src="{{actor.img}}" alt="{{actor.name}}">
  </div>

  <div class="v-head-main">
    <div class="v-title-row">
      {{#if editable}}
      <input class="v-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'VITRUVIUM.Sheet.name'}}">
      {{else}}
      <h1 class="v-name">{{actor.name}}</h1>
      {{/if}}
      <button type="button" class="v-mode" data-action="openStats" data-tooltip="{{localize 'VITRUVIUM.Sheet.statsHint'}}">
        <i class="fa-solid fa-table-list"></i> {{localize 'VITRUVIUM.Sheet.stats'}}
      </button>
    </div>

    {{#if isCharacter}}
    <div class="v-meta-row">
      {{#if editable}}
      <input class="v-player" type="text" name="system.player" value="{{system.player}}" placeholder="{{localize 'VITRUVIUM.Sheet.player'}}">
      {{else if system.player}}
      <span class="v-player">{{system.player}}</span>
      {{/if}}

      <div class="v-field">
        <span class="v-eyebrow">{{localize 'VITRUVIUM.Level.title'}}</span>
        <div class="v-seg" role="group">
          {{#each levels}}
          <button type="button" class="{{#if active}}active{{/if}}" data-action="setLevel" data-level="{{key}}" data-tooltip="{{label}}. {{hint}}" {{#unless ../editable}}disabled{{/unless}}>{{points}}</button>
          {{/each}}
        </div>
      </div>
    </div>
    {{/if}}
  </div>
</header>

<section class="v-strip">
  <div class="v-chars" data-tooltip="{{localize 'VITRUVIUM.Sheet.rollHint'}}" data-tooltip-direction="UP">
    {{#each characteristics}}
    <div class="v-char" data-characteristic="{{key}}">
      <button type="button" class="v-char-roll" data-action="roll" data-tooltip="{{hint}}">
        <span class="v-icon" style="-webkit-mask-image:url('{{icon}}');mask-image:url('{{icon}}')"></span>
        <span class="v-char-label">{{label}}</span>
      </button>
      <span class="v-char-value">{{value}}</span>
      <span class="v-pips">
        {{#each pips}}<button type="button" class="v-pip {{#if on}}on{{/if}}" data-action="setCharacteristic" data-value="{{n}}" {{#unless ../../editable}}disabled{{/unless}} aria-label="{{n}}"></button>{{/each}}
      </span>
    </div>
    {{/each}}
  </div>

  <div class="v-inspiration">
    <span class="v-eyebrow">{{localize 'VITRUVIUM.Sheet.inspiration'}} {{inspiration.value}}/{{inspiration.max}}</span>
    <span class="v-stars">
      {{#each inspiration.pips}}
      <button type="button" class="v-star {{#if on}}on{{/if}}" data-action="setInspiration" data-value="{{n}}" aria-pressed="{{on}}" aria-label="{{n}}" {{#unless ../isGM}}{{#unless ../editable}}disabled{{/unless}}{{/unless}}><span class="v-star-icon" style="-webkit-mask-image:url('{{../inspirationIcon}}');mask-image:url('{{../inspirationIcon}}')"></span></button>
      {{/each}}
    </span>
  </div>
</section>

{{#if budget}}
<section class="v-budget" data-tooltip="{{localize 'VITRUVIUM.Budget.hint'}}">
  {{#each budget}}
  <span class="v-chip {{#if over}}over{{/if}}">{{label}} <b>{{value}}</b> {{localize 'VITRUVIUM.Budget.of'}} {{max}}</span>
  {{/each}}
</section>
{{/if}}
</div>
