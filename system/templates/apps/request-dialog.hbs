<div class="v-dialog">
  <div class="form-group">
    <label>{{localize 'VITRUVIUM.Check.Characteristic'}}</label>
    <select name="characteristic">
      <option value="">{{localize 'VITRUVIUM.Request.Any'}}</option>
      {{#each characteristics}}<option value="{{key}}">{{label}}</option>{{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize 'VITRUVIUM.Check.Difficulty'}}</label>
    <select name="difficulty">
      <option value="">{{localize 'VITRUVIUM.Check.NoDifficulty'}}</option>
      {{#each difficulties}}<option value="{{this}}">{{this}}</option>{{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize 'VITRUVIUM.Check.Advantages'}}</label>
    <select name="advantages">{{#each modifiers}}<option value="{{this}}">{{this}}</option>{{/each}}</select>
  </div>
  <div class="form-group">
    <label>{{localize 'VITRUVIUM.Check.Hindrances'}}</label>
    <select name="hindrances">{{#each modifiers}}<option value="{{this}}">{{this}}</option>{{/each}}</select>
  </div>
  <div class="form-group stacked">
    <label>{{localize 'VITRUVIUM.Request.Note'}}</label>
    <input type="text" name="note">
  </div>
</div>
