<div class="v-welcome">
  <header class="v-welcome-head">
    <img class="v-welcome-mark" src="systems/vitruvium/assets/dice/face-1.svg" alt="">
    <div>
      <p class="v-eyebrow">{{localize 'VITRUVIUM.Welcome.eyebrow' version=rulesVersion}}</p>
      <h1>{{localize 'VITRUVIUM.Welcome.name'}}</h1>
      <p><em>{{localize 'VITRUVIUM.Welcome.tagline'}}</em></p>
    </div>
  </header>

  <section class="v-block">
    <h2 class="v-eyebrow">{{localize 'VITRUVIUM.Welcome.howTo'}}</h2>
    <ol class="v-steps">
      {{#each steps}}<li>{{{this}}}</li>{{/each}}
    </ol>
    <button type="button" class="v-btn wide" data-action="openRules"><i class="fa-solid fa-book-open"></i> {{localize 'VITRUVIUM.Welcome.openRules'}}</button>
    {{#if rulesNote}}<p class="v-hint">{{rulesNote}}</p>{{/if}}
  </section>

  <section class="v-block">
    <h2 class="v-eyebrow">{{localize 'VITRUVIUM.Welcome.authors'}}</h2>
    <dl class="v-credits">
      <dt>{{localize 'VITRUVIUM.Welcome.creditVersion'}}</dt><dd>Beta 3.1*</dd>
      <dt>{{localize 'VITRUVIUM.Welcome.creditAuthor'}}</dt><dd>{{localize 'VITRUVIUM.Welcome.nameAuthor'}}</dd>
      <dt>{{localize 'VITRUVIUM.Welcome.creditLeads'}}</dt><dd>{{localize 'VITRUVIUM.Welcome.nameLeads'}}</dd>
      <dt>{{localize 'VITRUVIUM.Welcome.creditWeb'}}</dt><dd>{{localize 'VITRUVIUM.Welcome.nameWeb'}}</dd>
      <dt>{{localize 'VITRUVIUM.Welcome.creditUx'}}</dt><dd>{{localize 'VITRUVIUM.Welcome.nameUx'}}</dd>
      <dt>{{localize 'VITRUVIUM.Welcome.creditDevs'}}</dt><dd>{{localize 'VITRUVIUM.Welcome.nameDevs'}}</dd>
      <dt>{{localize 'VITRUVIUM.Welcome.creditDesign'}}</dt><dd>{{localize 'VITRUVIUM.Welcome.nameDesign'}}</dd>
    </dl>
    <p class="v-hint"><em>{{localize 'VITRUVIUM.Welcome.betaNote'}}</em></p>
    <p class="v-hint">{{localize 'VITRUVIUM.Welcome.rulesLink'}}: <a href="https://vitruvium.ru/rules" target="_blank" rel="noopener">vitruvium.ru/rules</a>. {{localize 'VITRUVIUM.Welcome.foundryCredit' version=version}}</p>
  </section>

  <footer class="v-welcome-foot">
    <div class="v-welcome-actions">
      {{#if showOnStart}}
      <button type="button" class="v-btn" data-action="hideOnStart"><i class="fa-solid fa-eye-slash"></i> {{localize 'VITRUVIUM.Welcome.hide'}}</button>
      {{else}}
      <button type="button" class="v-btn" data-action="showOnStart"><i class="fa-solid fa-eye"></i> {{localize 'VITRUVIUM.Welcome.show'}}</button>
      {{/if}}
      <button type="button" class="v-btn v-btn-accent" data-action="close"><i class="fa-solid fa-xmark"></i> {{localize 'VITRUVIUM.Welcome.close'}}</button>
    </div>
    <span class="v-hint">{{localize 'VITRUVIUM.Welcome.reopen'}}</span>
  </footer>
</div>
